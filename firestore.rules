rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roomPath(roomCode) {
      return /databases/$(database)/documents/rooms/$(roomCode);
    }

    function invitePath(roomCode) {
      return /databases/$(database)/documents/roomInvites/$(roomCode);
    }

    function playerPath(roomCode, uid) {
      return /databases/$(database)/documents/rooms/$(roomCode)/players/$(uid);
    }

    function cleanupHasStarted(data) {
      return data.keys().hasAny(['cleanupStarted']) && data.cleanupStarted == true;
    }

    function cleanupHasNotStarted(data) {
      return !data.keys().hasAny(['cleanupStarted']) || data.cleanupStarted != true;
    }

    function markerPath(roomCode, uid) {
      return /databases/$(database)/documents/rooms/$(roomCode)/cleanupMarkers/$(uid);
    }

    function schemaThreeRoom(roomCode) {
      return exists(roomPath(roomCode)) && get(roomPath(roomCode)).data.schemaVersion == 3;
    }

    function roomMember(roomCode) {
      return signedIn()
        && schemaThreeRoom(roomCode)
        && exists(playerPath(roomCode, request.auth.uid));
    }

    function cleanupMember(roomCode) {
      return signedIn()
        && schemaThreeRoom(roomCode)
        && cleanupHasStarted(get(roomPath(roomCode)).data)
        && exists(markerPath(roomCode, request.auth.uid));
    }

    function roomAccess(roomCode) {
      return roomMember(roomCode) || cleanupMember(roomCode);
    }

    function isHost(roomCode) {
      return roomMember(roomCode) && get(roomPath(roomCode)).data.adminId == request.auth.uid;
    }

    function hostPlayerUpdate(roomCode) {
      return isHost(roomCode)
        && cleanupHasNotStarted(get(roomPath(roomCode)).data)
        && ((get(roomPath(roomCode)).data.status == 'playing'
            && getAfter(roomPath(roomCode)).data.status == 'playing'
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isReady']))
          || (get(roomPath(roomCode)).data.status == 'lobby'
            && getAfter(roomPath(roomCode)).data.status == 'playing'
            && request.resource.data.isReady == false)
          || (get(roomPath(roomCode)).data.status == 'playing'
            && getAfter(roomPath(roomCode)).data.status == 'lobby'
            && request.resource.data.isReady == false));
    }

    function idleLobby(roomCode) {
      return schemaThreeRoom(roomCode)
        && get(roomPath(roomCode)).data.status == 'lobby'
        && get(roomPath(roomCode)).data.lastActivityAt <= request.time - duration.value(30, 'm');
    }

    function canClean(roomCode) {
      return roomAccess(roomCode)
        && (cleanupHasStarted(get(roomPath(roomCode)).data) || idleLobby(roomCode));
    }

    function isEmptyPrivateHand(data) {
      return data.keys().hasOnly(['cards', 'exchangeOptions'])
        && data.cards is list && data.cards.size() == 0
        && data.exchangeOptions is list && data.exchangeOptions.size() == 0;
    }

    function roomCreatedByCaller(roomCode) {
      return signedIn()
        && existsAfter(roomPath(roomCode))
        && getAfter(roomPath(roomCode)).data.schemaVersion == 3
        && getAfter(roomPath(roomCode)).data.status == 'lobby'
        && getAfter(roomPath(roomCode)).data.adminId == request.auth.uid
        && existsAfter(invitePath(roomCode))
        && getAfter(invitePath(roomCode)).data.playerCount == 1;
    }

    function joiningCaller(roomCode) {
      return signedIn()
        && exists(invitePath(roomCode))
        && get(invitePath(roomCode)).data.schemaVersion == 3
        && get(invitePath(roomCode)).data.status == 'lobby'
        && get(invitePath(roomCode)).data.playerCount < 6
        && existsAfter(invitePath(roomCode))
        && getAfter(invitePath(roomCode)).data.playerCount == get(invitePath(roomCode)).data.playerCount + 1
        && existsAfter(roomPath(roomCode))
        && getAfter(roomPath(roomCode)).data.status == 'lobby'
        && cleanupHasNotStarted(getAfter(roomPath(roomCode)).data)
        && existsAfter(playerPath(roomCode, request.auth.uid))
        && !exists(playerPath(roomCode, request.auth.uid));
    }

    function validPlayer(data) {
      return data.keys().hasOnly(['name', 'coins', 'isDead', 'influenceCount', 'revealedCards', 'avatarId', 'isReady'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 24
        && data.coins == 2 && data.isDead == false && data.influenceCount == 2
        && data.revealedCards is list && data.revealedCards.size() == 0
        && data.avatarId in ['male', 'female'] && data.isReady == false;
    }

    function validResponseTimeout(data) {
      return !data.keys().hasAny(['responseTimeoutSeconds'])
        || (data.responseTimeoutSeconds is int && data.responseTimeoutSeconds in [15, 30, 45, 60]);
    }

    function validCommand(data) {
      return data.keys().hasOnly(['actorUid', 'payload', 'createdAt'])
        && data.actorUid == request.auth.uid
        && data.createdAt == request.time
        && data.payload is map
        && data.payload.type in ['action', 'respond', 'discard', 'exchange', 'surrender', 'expireResponses'];
    }

    function validCoinChange(data) {
      return data is map && data.keys().hasOnly(['playerId', 'playerName', 'before', 'after'])
        && data.playerId is string && data.playerName is string && data.before is int && data.after is int;
    }
    function validInfluenceChange(data) {
      return data is map && data.keys().hasOnly(['playerId', 'playerName', 'before', 'after', 'revealed'])
        && data.playerId is string && data.playerName is string && data.before is int && data.after is int
        && data.revealed is list && data.revealed.size() <= 2
        && data.revealed.hasOnly(['Duke', 'Assassin', 'Captain', 'Ambassador', 'Contessa']);
    }
    function validEventChanges(coins, influence) {
      return coins is list && coins.size() <= 2 && influence is list && influence.size() <= 1
        && (coins.size() < 1 || validCoinChange(coins[0])) && (coins.size() < 2 || validCoinChange(coins[1]))
        && (influence.size() < 1 || validInfluenceChange(influence[0]));
    }

    match /roomInvites/{roomCode} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if roomCode.matches('^[A-HJ-NP-Z]{8}$')
        && roomCreatedByCaller(roomCode)
        && request.resource.data.keys().hasOnly(['schemaVersion', 'status', 'playerCount'])
        && request.resource.data.schemaVersion == 3
        && request.resource.data.status == 'lobby'
        && request.resource.data.playerCount == 1;

      allow update: if signedIn() && (
        (isHost(roomCode)
          && cleanupHasNotStarted(get(roomPath(roomCode)).data)
          && request.resource.data.schemaVersion == resource.data.schemaVersion
          && request.resource.data.playerCount == resource.data.playerCount
          && request.resource.data.status in ['lobby', 'playing'])
        || (resource.data.status == 'lobby'
          && request.resource.data.status == 'lobby'
          && request.resource.data.playerCount == resource.data.playerCount + 1
          && request.resource.data.playerCount <= 6
          && existsAfter(playerPath(roomCode, request.auth.uid))
          && !exists(playerPath(roomCode, request.auth.uid)))
        || (isHost(roomCode)
          && cleanupHasNotStarted(get(roomPath(roomCode)).data)
          && resource.data.status == 'lobby'
          && request.resource.data.status == 'lobby'
          && request.resource.data.playerCount == resource.data.playerCount - 1)
        || (roomMember(roomCode)
          && resource.data.status == 'lobby'
          && cleanupHasNotStarted(get(roomPath(roomCode)).data)
          && request.resource.data.status == resource.data.status
          && request.resource.data.playerCount == resource.data.playerCount - 1
          && !existsAfter(playerPath(roomCode, request.auth.uid)))
        || (roomMember(roomCode)
          && idleLobby(roomCode)
          && request.resource.data.status == 'closed'
          && request.resource.data.playerCount == resource.data.playerCount)
        || (isHost(roomCode)
          && request.resource.data.status == 'closed'
          && request.resource.data.playerCount == 0
          && cleanupHasStarted(getAfter(roomPath(roomCode)).data))
      );

      allow delete: if isHost(roomCode) || canClean(roomCode);
    }

    match /rooms/{roomCode} {
      allow get: if roomAccess(roomCode);
      allow list: if false;

      allow create: if signedIn()
        && roomCode.matches('^[A-HJ-NP-Z]{8}$')
        && request.resource.data.schemaVersion == 3
        && request.resource.data.status == 'lobby'
        && request.resource.data.adminId == request.auth.uid
        && validResponseTimeout(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastActivityAt == request.time
        && existsAfter(invitePath(roomCode))
        && existsAfter(playerPath(roomCode, request.auth.uid));

      allow update: if validResponseTimeout(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['responseTimeoutSeconds'])
          || (isHost(roomCode) && resource.data.status == 'lobby'
            && request.resource.data.status == 'lobby' && cleanupHasNotStarted(resource.data)))
        && ((signedIn()
          && resource.data.schemaVersion == 3
          && resource.data.adminId == request.auth.uid
          && exists(playerPath(roomCode, request.auth.uid))
          && cleanupHasNotStarted(resource.data)
          && request.resource.data.schemaVersion == 3
          && request.resource.data.adminId is string
          && (request.resource.data.adminId == resource.data.adminId
            || existsAfter(playerPath(roomCode, request.resource.data.adminId))))
        || (roomMember(roomCode)
          && cleanupHasNotStarted(resource.data)
          && resource.data.status == 'lobby'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActivityAt', 'expiresAt']))
        || (joiningCaller(roomCode)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActivityAt', 'expiresAt']))
        || (isHost(roomCode)
          && resource.data.status == 'lobby'
          && request.resource.data.cleanupStarted == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cleanupStarted']))
        || (roomMember(roomCode)
          && idleLobby(roomCode)
          && request.resource.data.cleanupStarted == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cleanupStarted'])));

      allow delete: if canClean(roomCode);

      match /players/{playerUid} {
        allow get: if roomAccess(roomCode)
          || (signedIn() && playerUid == request.auth.uid
            && exists(invitePath(roomCode)) && get(invitePath(roomCode)).data.status == 'lobby');
        allow list: if roomAccess(roomCode);
        allow create: if signedIn() && playerUid == request.auth.uid
          && validPlayer(request.resource.data)
          && (roomCreatedByCaller(roomCode) || joiningCaller(roomCode));
        allow update: if hostPlayerUpdate(roomCode)
          || (signedIn() && playerUid == request.auth.uid
            && roomMember(roomCode)
            && get(roomPath(roomCode)).data.status == 'lobby'
            && cleanupHasNotStarted(get(roomPath(roomCode)).data)
            && request.resource.data.isReady is bool
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isReady']));
        allow delete: if canClean(roomCode)
          || (roomMember(roomCode) && playerUid == request.auth.uid
            && get(roomPath(roomCode)).data.status == 'lobby')
          || (isHost(roomCode) && get(roomPath(roomCode)).data.status == 'lobby');
      }

      match /privatePlayers/{playerUid} {
        allow get: if roomAccess(roomCode)
          && (playerUid == request.auth.uid || isHost(roomCode) || canClean(roomCode))
          || (signedIn() && playerUid == request.auth.uid
            && exists(invitePath(roomCode)) && get(invitePath(roomCode)).data.status == 'lobby');
        allow list: if isHost(roomCode) || canClean(roomCode);
        allow create: if signedIn() && playerUid == request.auth.uid
          && isEmptyPrivateHand(request.resource.data)
          && (roomCreatedByCaller(roomCode) || joiningCaller(roomCode));
        allow update: if isHost(roomCode) && cleanupHasNotStarted(get(roomPath(roomCode)).data);
        allow delete: if canClean(roomCode)
          || (roomMember(roomCode) && playerUid == request.auth.uid
            && get(roomPath(roomCode)).data.status == 'lobby')
          || (isHost(roomCode) && get(roomPath(roomCode)).data.status == 'lobby');
      }

      match /internal/{document=**} {
        allow read: if isHost(roomCode) || canClean(roomCode);
        allow create: if (isHost(roomCode)
          && cleanupHasNotStarted(get(roomPath(roomCode)).data))
          || roomCreatedByCaller(roomCode);
          allow update: if isHost(roomCode) && cleanupHasNotStarted(get(roomPath(roomCode)).data);
        allow delete: if isHost(roomCode) || canClean(roomCode);
      }

      match /commands/{commandId} {
        allow get: if isHost(roomCode)
          || (roomMember(roomCode) && resource.data.actorUid == request.auth.uid);
        allow list: if isHost(roomCode) || canClean(roomCode);
        allow create: if roomMember(roomCode)
          && get(roomPath(roomCode)).data.status == 'playing'
            && cleanupHasNotStarted(get(roomPath(roomCode)).data)
          && validCommand(request.resource.data)
          && (request.resource.data.payload.type != 'expireResponses'
            || (isHost(roomCode) && request.resource.data.payload.responseWindowId is string));
        allow update: if false;
        allow delete: if isHost(roomCode) || canClean(roomCode);
      }

      match /commandResults/{commandId} {
        // The listener starts before the host creates the result. Only its command author may wait.
        allow get: if isHost(roomCode)
          || (roomAccess(roomCode) && (
            (exists(/databases/$(database)/documents/rooms/$(roomCode)/commandResults/$(commandId))
              && resource.data.actorUid == request.auth.uid)
            || (!exists(/databases/$(database)/documents/rooms/$(roomCode)/commandResults/$(commandId))
              && exists(/databases/$(database)/documents/rooms/$(roomCode)/commands/$(commandId))
              && get(/databases/$(database)/documents/rooms/$(roomCode)/commands/$(commandId)).data.actorUid == request.auth.uid)
          ));
        allow list: if isHost(roomCode) || canClean(roomCode);
        allow create: if isHost(roomCode)
            && cleanupHasNotStarted(get(roomPath(roomCode)).data)
          && request.resource.data.keys().hasOnly(['actorUid', 'ok', 'message', 'completedAt'])
          && request.resource.data.actorUid == get(/databases/$(database)/documents/rooms/$(roomCode)/commands/$(commandId)).data.actorUid
          && request.resource.data.ok is bool
          && request.resource.data.message is string
          && request.resource.data.completedAt == request.time;
        allow update: if false;
        allow delete: if isHost(roomCode) || canClean(roomCode);
      }

      match /events/{eventId} {
        allow read: if roomAccess(roomCode);
        allow create: if isHost(roomCode) && cleanupHasNotStarted(get(roomPath(roomCode)).data)
          && request.resource.data.keys().hasOnly(['roundId', 'sequence', 'turnNumber', 'actionId', 'kind',
            'actorId', 'actorName', 'sourceId', 'targetId', 'targetName', 'actionName', 'claimedRole',
            'challengeSucceeded', 'outcome', 'at', 'coinChanges', 'influenceChanges'])
          && request.resource.data.roundId == getAfter(roomPath(roomCode)).data.roundId
          && request.resource.data.roundId is string
          && request.resource.data.sequence == getAfter(roomPath(roomCode)).data.eventSequence
          && request.resource.data.sequence is int && request.resource.data.sequence > 0
          && request.resource.data.turnNumber is int && request.resource.data.turnNumber > 0
          && request.resource.data.actionId is string
          && request.resource.data.kind in ['start', 'action', 'pass', 'block', 'challenge', 'discard', 'exchange', 'surrender', 'timeout']
          && request.resource.data.actorId is string && request.resource.data.actorName is string
          && (request.resource.data.sourceId == null || request.resource.data.sourceId is string)
          && (request.resource.data.targetId == null || request.resource.data.targetId is string)
          && (request.resource.data.targetName == null || request.resource.data.targetName is string)
          && (request.resource.data.actionName == null || request.resource.data.actionName in ['Income', 'ForeignAid', 'Coup', 'Tax', 'Assassinate', 'Steal', 'Exchange'])
          && (request.resource.data.claimedRole == null || request.resource.data.claimedRole in ['Duke', 'Assassin', 'Captain', 'Ambassador', 'Contessa'])
          && (request.resource.data.challengeSucceeded == null || request.resource.data.challengeSucceeded is bool)
          && request.resource.data.outcome is string && request.resource.data.outcome.size() <= 2000
          && request.resource.data.at == request.time
          && validEventChanges(request.resource.data.coinChanges, request.resource.data.influenceChanges);
        allow update: if false;
        allow delete: if canClean(roomCode);
      }

      match /cleanupMarkers/{uid} {
        allow get: if signedIn() && uid == request.auth.uid && roomAccess(roomCode);
        allow list: if canClean(roomCode);
        allow create: if signedIn() && uid == request.auth.uid && roomAccess(roomCode)
          && (idleLobby(roomCode) || cleanupHasStarted(getAfter(roomPath(roomCode)).data));
        allow update: if false;
        allow delete: if canClean(roomCode);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
